# Cloudflare R2 S3 API
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=operator-scan
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPERATOR_DATA_KEY=
OPERATOR_SYNC_TOKEN=
OPERATOR_SESSION_SECRET=
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=
OPERATOR_ADMIN_USERNAME=admin
OPERATOR_ADMIN_PASSWORD=

# Existing extract-link settings from the main project
EXTRACT_LINK_PROVIDER=auto
EXTRACT_LINK_API_BASE=https://pay.cccy.me
EXTRACT_LINK_CDK=
EXTRACT_LINK_TYPE=pix
EXTRACT_LINK_EVENT_TIMEOUT=600
